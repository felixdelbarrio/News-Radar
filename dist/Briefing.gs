 return {subject,period,scope,preheader:fortnightly?(query.country?'Novedades y movimientos competitivos en canales digitales para empresas e instituciones.':'Novedades internacionales en canales digitales para empresas e instituciones.'):'Hasta tres movimientos competitivos destacados para tu canal.'};
