  for(const row of ranked){const key=perGeography?(geography(row)===otherGeography?geography.region(row.pais)||otherGeography:geography(row)):'',count=counts.get(key)||0;if(count<limit){items.push(row);counts.set(key,count+1);}}
  const regions=noveltyOverview(ranked.filter(row=>geography(row)===otherGeography&&geography.region(row.pais)),BRIEFING_ALLOWED_SIGNALS,row=>geography.region(row.pais)).geographies;
