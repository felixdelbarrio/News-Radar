function newsletterWords_(text,limit){const words=plainText_(text).split(/\s+/).filter(Boolean);return words.slice(0,limit).join(' ')+(words.length>limit?'…':'');}
function newsletterSelectionQuery_(query){return {...query,country:''};}
function newsletterDigest_(items,query,language,t,known=new Set()){
 items=items.filter(briefingAllowed);
 const cadence=Object.entries(newsletterCadences).find(([,value])=>value.view===(query.view||'briefing'))?.[0];if(!cadence)throw Error('Periodicidad no válida.');
 const fortnightly=cadence==='fortnightly',focused=Boolean(query.country),scopeOf=row=>focused&&row.pais===query.country?'local':'global',buckets={local:[],global:[]},groups=new Map();
 for(const row of items){const scope=scopeOf(row);buckets[scope].push(row);for(const tag of row.taxonomia.length?row.taxonomia:[{palanca:'Otros',subpalanca:''}]){if(query.palanca&&tag.palanca!==query.palanca||query.subpalanca&&taxonomyPath(tag)!==query.subpalanca)continue;const key=scope+'|'+tag.palanca;if(!groups.has(key))groups.set(key,{scope,tag,rows:new Map()});groups.get(key).rows.set(row.id,row);}}
 const candidates=[...groups.values()].map(group=>{const rows=[...group.rows.values()].sort((a,b)=>Number(newsletterWasSent_(a,known))-Number(newsletterWasSent_(b,known))||newsRelevance_(b)-newsRelevance_(a)||b.fecha.localeCompare(a.fecha)||a.id.localeCompare(b.id));return {...group,rows,row:rows[0],entities:new Set(rows.map(row=>row.entidad)).size};});
 // Count distinct evidence in the same geography/block, as in the heatmap; relevance breaks ties.
 candidates.sort((a,b)=>b.rows.length-a.rows.length||b.entities-a.entities||newsRelevance_(b.row)-newsRelevance_(a.row)||a.tag.palanca.localeCompare(b.tag.palanca,'es'));
 const limit=fortnightly?Math.min(NEWSLETTER_EDITORIAL.cards,settings_().briefingLimit):focused?2:1,chosen=[],ids=new Set(),blocks=new Set();
 function choose(entries,budget){for(const entry of entries){if(budget<=0||chosen.length>=limit)break;if(chosen.some(item=>item.scope===entry.scope&&item.tag.palanca===entry.tag.palanca))continue;const row=entry.rows.find(row=>!ids.has(row.id));if(!row)continue;chosen.push({...entry,row});ids.add(row.id);blocks.add(entry.tag.palanca);budget--;}}
 const local=candidates.filter(row=>row.scope==='local'),global=candidates.filter(row=>row.scope==='global');
 if(focused)choose(local,fortnightly?(global.length?Math.max(1,limit-1):limit):1);
 if(fortnightly){choose(global.filter(row=>!blocks.has(row.tag.palanca)),limit-chosen.length);choose(global,limit-chosen.length);}else choose(global,1);
 const cards=chosen.map(({row,tag,rows,scope,entities})=>({id:row.id,title:newsletterWords_(row.titular,NEWSLETTER_EDITORIAL.titleWords),fact:newsletterWords_(row.extracto,NEWSLETTER_EDITORIAL.factWords),relevance:newsletterWords_(fortnightly?formatText('Señal inmediata: {signal}.',{signal:t(row.senales[0]||'Noticia')},language):formatText('Tema observado en {count} entidades; comparar sus propuestas y fuentes.',{count:entities},language),NEWSLETTER_EDITORIAL.relevanceWords),evidenceIds:rows.slice(0,NEWSLETTER_EDITORIAL.supportItems).map(row=>row.id),relatedCount:rows.length,additionalCount:rows.length-1,entityCount:entities,countryCount:new Set(rows.map(row=>row.pais).filter(Boolean)).size,scope,countries:[...new Set(rows.map(row=>row.pais).filter(Boolean))],subcategory:tag.subpalanca||'',subcategoryPath:taxonomyPath(tag),subcategories:[...new Set(row.taxonomia.filter(item=>item.palanca===tag.palanca).map(item=>item.subpalanca))],category:tag.palanca,entity:row.entidad,country:row.pais,publisher:row.medio,date:row.fecha,url:canonicalUrl_(row.url)}));
 return {cadence,heading:t(fortnightly?'Movimientos de la quincena':'Balance del trimestre'),intro:t(fortnightly?'Novedades concretas para revisar esta quincena.':'Qué ha marcado tu canal y dónde mirar ahora.'),cards,reusedCount:chosen.filter(({row})=>newsletterWasSent_(row,known)).length,landscapes:fortnightly?null:{local:focused?newsletterLandscape_(buckets.local):null,global:newsletterLandscape_(buckets.global)},focusLabel:'Bloque funcional',focused,localCount:buckets.local.length,globalCount:buckets.global.length,context:query,scope:JSON.parse(JSON.stringify(configuration_().applicationScope)),geographies:JSON.parse(JSON.stringify(configuration_().geographies))};
}
