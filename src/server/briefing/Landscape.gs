  return {...comparison,panels,contrasts,unassigned,geographies:[...geographies.values()].map(({name,total,themes})=>({name,total,theme:[...themes].map(([name,count])=>({name,count})).sort(newsletterCoverageOrder_)[0]||null})).sort((a,b)=>b.total-a.total||a.name.localeCompare(b.name,'es')).slice(0,NEWSLETTER_EDITORIAL.cards)};
