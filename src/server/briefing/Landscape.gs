  const prompts=[t('Contrasta las diferencias de cobertura con tus prioridades comerciales.'),t('Revisa qué iniciativas del grupo en otras geografías merecen contrastarse en tu canal.'),t('Valida las propuestas internacionales en las fuentes antes de incorporarlas a tu hoja de ruta.')];
