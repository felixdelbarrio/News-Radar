  const images=new Map([['bia-logo',{id:'bia-logo',data:NEWSLETTER_BIA_PNG}]]);
  const escape=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
  const label=value=>escape(t(value)),count=(value,singular,plural)=>noveltyCount(value,singular,plural,label),selection=newsletterSubject_({...query,from:'',to:''},language,t).slice(6);
  const period=query.from&&query.to?formatCalendarDay(query.from,language)+' — '+formatCalendarDay(query.to,language):formatCalendarDay(recordDay(now,settings_().timezone),language);
  const heading=weekly?'Tu radar de novedades':annual?'El año en perspectiva':'Las claves del mes',unit=weekly?'novedad':'noticia',units=weekly?'novedades':'noticias';
  const metrics=weekly?[{name:'Novedades detectadas',total:overview.total},...overview.bySignal]:[{name:'Noticias analizadas',total:overview.total},{name:'Entidades',total:overview.entities},{name:'Geografías',total:groups.length},{name:'Palancas activas',total:new Set(evidence.flatMap(row=>row.taxonomia.map(item=>item.palanca))).size}];
  const kpis='<table role="presentation" class="newsletter-kpis" cellspacing="0" cellpadding="0">'+metrics.map((metric,index)=>(index%2===0?'<tr>':'')+'<td class="newsletter-kpi"><strong class="newsletter-kpi-value">'+metric.total+'</strong><span class="newsletter-kpi-label">'+label(metric.name)+'</span></td>'+(index%2===1?'</tr>':index===metrics.length-1?'<td></td></tr>':'')).join('')+'</table>';
  const article=row=>'<article class="newsletter-article"><table role="presentation" class="newsletter-article-heading"><tr><td><h3><a href="'+escape(canonicalUrl_(row.url))+'">'+escape(row.titular)+'</a></h3></td><td class="newsletter-identity-cell">'+storyIdentity(row.entidad,row.pais,escape,images)+'</td></tr></table><p class="newsletter-excerpt">'+escape(newsletterExcerpt_(row.extracto)||t('Consulta la fuente original para conocer la oferta y sus condiciones.'))+'</p><p class="newsletter-meta">'+escape(formatCalendarDay(row.fecha,language))+' · '+identityMark('publishers',row.medio,escape,images)+escape(row.medio)+'</p><a class="newsletter-source" href="'+escape(canonicalUrl_(row.url))+'">'+label('Consultar')+' ↗</a></article>';
