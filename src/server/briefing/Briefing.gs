    return '<section class="newsletter-geography"><table role="presentation" class="newsletter-geography-heading"><tr><td class="newsletter-chapter">'+String(index+1).padStart(2,'0')+'</td><td><p class="newsletter-eyebrow">'+label('Geografía')+'</p><h2>'+identityMark('countries',group.name,escape,images)+label(geographyLabel(group.name))+'</h2></td><td class="newsletter-geography-count">'+group.items.length+'<span class="newsletter-count-label">'+label(group.items.length===1?unit:units)+'</span></td></tr></table>'+body+'</section>';
  }).join('');
  const footer='<footer>'+(links.app?'<p><a class="newsletter-cta" href="'+escape(links.app)+'">'+label('Ir a Newsradar')+' ↗</a></p>':'')+'<p>'+label('Has recibido esta selección por tu suscripción a News Radar.')+' '+label('Gestiona o da de baja tu suscripción desde Newsletter en News Radar.')+'</p>'+(links.manage?'<p><a href="'+escape(links.manage)+'">'+label('Gestiona tu suscripción')+'</a> · <a href="'+escape(links.unsubscribe)+'">'+label('Dar de baja')+'</a></p>':'')+'<table role="presentation" class="newsletter-brand"><tr><td><img src="cid:bia-logo" width="80" alt="bIA"></td><td>'+label('Impulsado por')+'<br><strong>'+label('Banca Inteligente y Autónoma')+'</strong></td></tr></table></footer>';
  const radar=annual?radarMetrics_(evidence,query):null,quarters=annual?[0,0,0,0]:[];if(annual)for(const row of evidence)quarters[Math.floor((Number(row.fecha.slice(5,7))-1)/3)]++;
