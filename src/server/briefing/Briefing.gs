  const insight=summary=>'<p class="newsletter-insight"><span class="newsletter-eyebrow">'+label('Palanca destacada')+'</span><br>'+label(summary.category)+' · '+count(summary.occurrences,'noticia','noticias')+' '+label('en esta palanca')+'</p>';
