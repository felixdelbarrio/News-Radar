  const html='<!doctype html><html lang="'+language+'"><head><meta charset="utf-8"><meta name="color-scheme" content="light only"><title>'+escape(title)+'</title><style>'+NEWSLETTER_STYLE+'</style></head><body><p class="newsletter-preheader">'+count(overview.total,unit,units)+' · '+count(groups.length,'geografía','geografías')+' · '+count(overview.entities,'entidad','entidades')+'</p><header><p class="newsletter-eyebrow">BBVA · News Radar</p><h1>'+label(heading)+'</h1><p class="newsletter-period">'+escape(period)+'</p><p class="newsletter-header-note">'+label('Banca de Empresas e Instituciones')+'</p></header><p class="newsletter-selection">'+escape(selection)+'</p>'+kpis+annualSummary+'<p class="newsletter-note">'+label(annual?'Presencia en noticias por categoría. Una noticia puede pertenecer a varias palancas.':'Una noticia por geografía, de la palanca con más presencia en el período.')+'</p>'+(groups.length?sections:'<p class="newsletter-note">'+label('No hay novedades detectadas en esta selección.')+'</p>')+footer+'</body></html>';
  const storyText=row=>[row.entidad,row.titular,formatCalendarDay(row.fecha,language)+' · '+row.medio,newsletterExcerpt_(row.extracto),canonicalUrl_(row.url)].filter(Boolean).join('\n');
  const chapters=groups.flatMap(group=>{
    if(annual)return [t('Geografía')+': '+t(geographyLabel(group.name)),...group.entities.flatMap(entity=>{const summary=digest.selections.get(entity);return [entity.name,...summary.categories.slice(0,5).map(category=>t(taxonomySubLabel(category.name))+': '+category.total),links.app?t('Explorar Radar')+': '+newsletterExploreLink_(links.app,view,group.name,entity.name):''];})];
    const summary=digest.selections.get(group);return [t('Geografía')+': '+t(geographyLabel(group.name)),t('Palanca destacada')+': '+t(summary.category)+' · '+summary.occurrences,storyText(summary.item),summary.remaining&&links.app?t('Ver más')+' · '+noveltyCount(summary.remaining,unit,units,t)+': '+newsletterExploreLink_(links.app,view,group.name):''];
  });
  const text=[title,selection,...metrics.map(row=>t(row.name)+': '+row.total),...(annual?quarters.map((total,index)=>t('Trimestre')+' '+(index+1)+': '+total):[]),...chapters,links.app?t('Ir a Newsradar')+': '+links.app:'',links.manage?t('Gestiona tu suscripción')+': '+links.manage:'',links.unsubscribe?t('Dar de baja')+': '+links.unsubscribe:'',t('Impulsado por')+' bIA · '+t('Banca Inteligente y Autónoma')].filter(Boolean).join('\n\n');
  return {subject:newsletterSubject_(query,language,t),html:newsletterInline_(html,escape),text,images:[...images.values()],editionId,count:items.length,total:overview.total,items,evidence};
